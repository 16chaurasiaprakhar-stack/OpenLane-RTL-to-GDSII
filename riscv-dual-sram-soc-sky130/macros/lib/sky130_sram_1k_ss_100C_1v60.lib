/* OpenRAM SkyWater 130nm 1KB SRAM Liberty Model */
/* Corner: SS | Temp: 100C | Voltage: 1.6V */

library (sky130_sram_1k_ss_100C_1v6) {
  technology (cmos);
  delay_model : table_lookup;
  bus_naming_style : "%s[%d]";
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1, pf);

  nom_process : 1.0;
  nom_temperature : 100.0;
  nom_voltage : 1.60;

  operating_conditions (typical) {
    process : 1.0;
    temperature : 100.0;
    voltage : 1.60;
  }
  default_operating_conditions : typical;

  lu_table_template(timing_template_2x2) {
    variable_1 : total_output_net_capacitance;
    variable_2 : input_net_transition;
    index_1 ("0.001, 0.100");
    index_2 ("0.010, 0.500");
  }

  cell (sky130_sram_1k) {
    area : 288000.0;
    dont_use : true;
    dont_touch : true;

    pg_pin (vccd1) {
      voltage_name : VDD;
      pg_type : primary_power;
    }
    pg_pin (vssd1) {
      voltage_name : VSS;
      pg_type : primary_ground;
    }

    pin (clk) {
      direction : input;
      capacitance : 0.080; /* 80 fF high capacitive load */
      clock : true;
      min_pulse_width_high () {
        timing_sense : non_unate;
        rise_constraint(scalar) { values("1.000"); }
      }
      min_pulse_width_low () {
        timing_sense : non_unate;
        fall_constraint(scalar) { values("1.000"); }
      }
    }
    pin (csb) {
      direction : input;
      capacitance : 0.006;
      timing () {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint(scalar) { values("1.250"); }
        fall_constraint(scalar) { values("1.250"); }
      }
      timing () {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint(scalar) { values("0.100"); }
        fall_constraint(scalar) { values("0.100"); }
      }
    }
    pin (web) {
      direction : input;
      capacitance : 0.006;
      timing () {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint(scalar) { values("1.250"); }
        fall_constraint(scalar) { values("1.250"); }
      }
      timing () {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint(scalar) { values("0.100"); }
        fall_constraint(scalar) { values("0.100"); }
      }
    }
